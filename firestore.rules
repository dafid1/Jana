rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'jehan@janax.app'
      );
    }

    function isChatModeratorData(chatData) {
      return isSignedIn() && (
        isAdmin() ||
        chatData.createdBy == request.auth.uid ||
        (chatData.keys().hasAny(['adminIds']) && chatData.adminIds is list && request.auth.uid in chatData.adminIds)
      );
    }

    function isNotBannedFromChatData(chatData) {
      return !(chatData.keys().hasAny(['bannedIds']) && chatData.bannedIds is list && request.auth.uid in chatData.bannedIds);
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(userId) && isOwner(userId) && request.auth.token.email == 'jehan@janax.app';
      allow delete: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isValidId(userId) && isSignedIn() && (
        (isOwner(userId) && (
          request.resource.data.role == 'user' ||
          request.auth.token.email == 'jehan@janax.app'
        )) ||
        isAdmin()
      );
      allow update: if isValidId(userId) && isSignedIn() && (
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'username', 'createdAt', 'createdBy']) &&
          (!request.resource.data.keys().hasAny(['blockedUserIds']) || (request.resource.data.blockedUserIds is list && request.resource.data.blockedUserIds.size() <= 200)) &&
          (!request.resource.data.keys().hasAny(['mutedChatIds']) || (request.resource.data.mutedChatIds is list && request.resource.data.mutedChatIds.size() <= 500)) &&
          (!request.resource.data.keys().hasAny(['pinnedChatIds']) || (request.resource.data.pinnedChatIds is list && request.resource.data.pinnedChatIds.size() <= 50))
        ) ||
        isAdmin()
      );
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;

      match /stickers/{stickerId} {
        allow get: if isValidId(userId) && isValidId(stickerId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(stickerId) && isOwner(userId) &&
          isValidUserSticker(request.resource.data, stickerId);
        allow update: if isValidId(userId) && isValidId(stickerId) && isOwner(userId) &&
          isValidUserSticker(request.resource.data, stickerId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isValidId(userId) && isValidId(stickerId) && isOwner(userId);
      }
    }

    // Admin-only account credentials registry (never readable by regular users)
    match /adminUserCredentials/{userId} {
      allow get: if isValidId(userId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && isSignedIn() && (isAdmin() || isOwner(userId)) &&
        request.resource.data.keys().hasAll(['uid', 'password', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['uid', 'password', 'updatedAt']) &&
        request.resource.data.uid == userId &&
        request.resource.data.password is string &&
        request.resource.data.password.size() >= 6 &&
        request.resource.data.password.size() <= 128 &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() <= 50;
      allow delete: if isValidId(userId) && isAdmin();
    }

    function isValidCalculatorLockPublic(data) {
      return data.keys().hasAll(['pinHash', 'salt', 'pinLength', 'version', 'updatedAt']) &&
        data.keys().hasOnly(['pinHash', 'salt', 'pinLength', 'version', 'updatedAt']) &&
        data.pinHash is string &&
        data.pinHash.size() == 64 &&
        data.salt is string &&
        data.salt.size() >= 16 &&
        data.salt.size() <= 64 &&
        data.pinLength is int &&
        data.pinLength >= 4 &&
        data.pinLength <= 12 &&
        data.version is int &&
        data.version >= 1 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 50;
    }

    function isValidCalculatorLockAdmin(data) {
      return data.keys().hasAll(['pin', 'version', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['pin', 'version', 'updatedAt', 'updatedBy']) &&
        data.pin is string &&
        data.pin.matches('^[0-9]{4,12}$') &&
        data.version is int &&
        data.version >= 1 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 50 &&
        data.updatedBy == request.auth.uid;
    }

    function isValidUserSticker(data, stickerId) {
      return data.keys().hasAll(['id', 'uid', 'emoji', 'name', 'label', 'url', 'isCustom', 'useCount', 'lastUsedAt', 'createdAt']) &&
        data.keys().hasOnly(['id', 'uid', 'emoji', 'name', 'label', 'url', 'isCustom', 'useCount', 'lastUsedAt', 'createdAt']) &&
        data.id is string &&
        data.id == stickerId &&
        isValidId(data.id) &&
        data.uid == request.auth.uid &&
        data.emoji is string &&
        data.emoji.size() <= 16 &&
        data.name is string &&
        data.name.size() <= 80 &&
        data.label is string &&
        data.label.size() <= 80 &&
        data.url is string &&
        data.url.size() >= 1 &&
        data.url.size() <= 350000 &&
        data.isCustom is bool &&
        data.useCount is int &&
        data.useCount >= 0 &&
        data.useCount <= 1000000 &&
        data.lastUsedAt is string &&
        data.lastUsedAt.size() <= 50 &&
        data.createdAt is string &&
        data.createdAt.size() <= 50;
    }

    function isValidCall(data, callId) {
      return data.keys().hasAll(['id', 'chatId', 'callerId', 'callerName', 'calleeIds', 'isVideo', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'chatId', 'callerId', 'callerName', 'callerPhoto', 'calleeIds', 'isVideo', 'status', 'offer', 'answer', 'createdAt', 'updatedAt', 'endedAt']) &&
        data.id == callId &&
        isValidId(data.id) &&
        isValidId(data.chatId) &&
        isValidId(data.callerId) &&
        data.callerName is string &&
        data.callerName.size() <= 100 &&
        data.calleeIds is list &&
        data.calleeIds.size() >= 1 &&
        data.calleeIds.size() <= 20 &&
        data.isVideo is bool &&
        data.status in ['ringing', 'connected', 'ended', 'declined', 'missed'] &&
        data.createdAt is string &&
        data.createdAt.size() <= 50 &&
        data.updatedAt is string &&
        data.updatedAt.size() <= 50;
    }

    function isValidCallCandidate(data) {
      return data.keys().hasAll(['senderId', 'candidate', 'createdAt']) &&
        data.keys().hasOnly(['senderId', 'candidate', 'createdAt']) &&
        data.senderId == request.auth.uid &&
        data.candidate is map &&
        data.createdAt is string &&
        data.createdAt.size() <= 50;
    }

    // Global calculator lock & decoy lock public hashes (single-doc get only)
    match /appConfig/{configId} {
      allow get: if isValidId(configId) && (configId == 'calculatorLock' || configId == 'decoyLock');
      allow list: if false;
      allow create, update: if isValidId(configId) && (configId == 'calculatorLock' || configId == 'decoyLock') && isAdmin() &&
        isValidCalculatorLockPublic(request.resource.data);
      allow delete: if isValidId(configId) && configId == 'decoyLock' && isAdmin();
    }

    // Admin-only calculator lock & decoy lock configuration
    match /adminConfig/{configId} {
      allow get: if isValidId(configId) && (configId == 'calculatorLock' || configId == 'decoyLock') && isAdmin();
      allow list: if false;
      allow create, update: if isValidId(configId) && (configId == 'calculatorLock' || configId == 'decoyLock') && isAdmin() &&
        isValidCalculatorLockAdmin(request.resource.data);
      allow delete: if isValidId(configId) && configId == 'decoyLock' && isAdmin();
    }

    // Group Invites lookup (requires knowing exact inviteCode)
    match /groupInvites/{inviteCode} {
      allow get: if isValidId(inviteCode) && isSignedIn();
      allow list: if false;
      allow create, update: if isValidId(inviteCode) && isSignedIn() && (
        request.resource.data.createdBy == request.auth.uid ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)) &&
          isChatModeratorData(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data))
      );
      allow delete: if isValidId(inviteCode) && isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
          isChatModeratorData(get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data))
      );
    }

    // Chats collection
    match /chats/{chatId} {
      allow get: if isValidId(chatId) && isSignedIn() && (
        resource == null ||
        resource.data.type == 'channel' ||
        request.auth.uid in resource.data.memberIds ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.type == 'group' && resource.data.inviteCode != null)
      );

      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        resource.data.createdBy == request.auth.uid
      );

      allow create: if isValidId(chatId) && isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.memberIds;

      allow update: if isValidId(chatId) && isSignedIn() && (
        // Tier 1: Chat creator, group/channel admin, or system admin
        isChatModeratorData(resource.data) ||
        // Tier 2: Active chat member sending messages, reading, or pinning
        (request.auth.uid in resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'unreadCounts', 'pinnedMessageId'])) ||
        // Tier 3: Active member leaving group or unsubscribing from channel
        (request.auth.uid in resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'membersCount', 'updatedAt']) &&
          !(request.auth.uid in request.resource.data.memberIds)) ||
        // Tier 4: Joining group via invite or subscribing to public channel (blocked if banned)
        ((resource.data.type == 'channel' || (resource.data.type == 'group' && resource.data.inviteCode != null)) &&
          isNotBannedFromChatData(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'membersCount', 'updatedAt']) &&
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds))
      );

      allow delete: if isValidId(chatId) && isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());

      // Messages sub-collection
      match /messages/{messageId} {
        allow get: if isValidId(chatId) && isValidId(messageId) && isSignedIn() && (
          chatId == 'saved_' + request.auth.uid ||
          (
            exists(/databases/$(database)/documents/chats/$(chatId)) && (
              get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'channel' ||
              get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid ||
              request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
            )
          )
        );
        allow list: if isValidId(chatId) && isSignedIn() && (
          chatId == 'saved_' + request.auth.uid ||
          (
            exists(/databases/$(database)/documents/chats/$(chatId)) && (
              get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'channel' ||
              get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid ||
              request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
            )
          )
        );
        allow create: if isValidId(chatId) && isValidId(messageId) && isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          exists(/databases/$(database)/documents/chats/$(chatId)) &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type != 'channel' ||
            isChatModeratorData(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
        allow update: if isValidId(chatId) && isValidId(messageId) && isSignedIn() &&
          exists(/databases/$(database)/documents/chats/$(chatId)) && (
            (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds && (
              resource.data.senderId == request.auth.uid ||
              isChatModeratorData(get(/databases/$(database)/documents/chats/$(chatId)).data) ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'isPinned', 'pollData', 'readBy', 'deletedFor'])
            )) ||
            (get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'channel' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pollData']))
          );
        allow delete: if isValidId(chatId) && isValidId(messageId) && isSignedIn() &&
          exists(/databases/$(database)/documents/chats/$(chatId)) && (
            resource.data.senderId == request.auth.uid ||
            isChatModeratorData(get(/databases/$(database)/documents/chats/$(chatId)).data)
          );
      }

      // Real-time typing & recording indicators sub-collection
      match /typing/{userId} {
        allow get: if isValidId(chatId) && isValidId(userId) && isSignedIn() &&
          exists(/databases/$(database)/documents/chats/$(chatId)) && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'channel' ||
            get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          );
        allow list: if isValidId(chatId) && isSignedIn() &&
          exists(/databases/$(database)/documents/chats/$(chatId)) && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'channel' ||
            get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          );
        allow create, update: if isValidId(chatId) && isValidId(userId) && isOwner(userId) &&
          exists(/databases/$(database)/documents/chats/$(chatId)) && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds
          ) &&
          request.resource.data.keys().hasAll(['uid', 'displayName', 'isTyping', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(['uid', 'displayName', 'isTyping', 'activity', 'updatedAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 100 &&
          request.resource.data.isTyping is bool &&
          (!request.resource.data.keys().hasAny(['activity']) || request.resource.data.activity in ['typing', 'recording']) &&
          request.resource.data.updatedAt is string &&
          request.resource.data.updatedAt.size() <= 50;
        allow delete: if isValidId(chatId) && isValidId(userId) && isOwner(userId);
      }
    }

    // Stories collection
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isValidId(storyId) && isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isValidId(storyId) && isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
      );
      allow delete: if isValidId(storyId) && isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // WebRTC Calls signaling collection
    match /calls/{callId} {
      allow get: if isValidId(callId) && isSignedIn() && (
        resource == null ||
        resource.data.callerId == request.auth.uid ||
        request.auth.uid in resource.data.calleeIds
      );
      allow list: if isSignedIn() && (
        resource.data.callerId == request.auth.uid ||
        request.auth.uid in resource.data.calleeIds
      );
      allow create: if isValidId(callId) && isSignedIn() &&
        isValidCall(request.resource.data, callId) &&
        request.resource.data.callerId == request.auth.uid;
      allow update: if isValidId(callId) && isSignedIn() &&
        isValidCall(request.resource.data, callId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.chatId == resource.data.chatId &&
        request.resource.data.callerId == resource.data.callerId &&
        (resource.data.callerId == request.auth.uid || request.auth.uid in resource.data.calleeIds);

      match /candidates/{candidateId} {
        allow get, list: if isValidId(callId) && isSignedIn() &&
          exists(/databases/$(database)/documents/calls/$(callId)) && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.calleeIds
          );
        allow create: if isValidId(callId) && isValidId(candidateId) && isSignedIn() &&
          isValidCallCandidate(request.resource.data) &&
          exists(/databases/$(database)/documents/calls/$(callId)) && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.calleeIds
          );
        allow delete: if isValidId(callId) && isValidId(candidateId) && isSignedIn() &&
          exists(/databases/$(database)/documents/calls/$(callId)) &&
          get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }
    }
  }
}
